#. Plugin Name of the plugin
msgid "PixelHunter Social Login"
msgstr "PixelHunter Social Login"

#. Description of the plugin
msgid "Google and Microsoft login/registration for WooCommerce (OAuth 2.0 / OpenID Connect) — self-contained, no third-party services."
msgstr "Início de sessão e registo com Google e Microsoft para o WooCommerce (OAuth 2.0 / OpenID Connect) — autónomo, sem serviços de terceiros."

msgid "Social Login"
msgstr "Início de sessão social"

msgid "Credentials"
msgstr "Credenciais"

msgid "Enable"
msgstr "Activar"

msgid "Client ID"
msgstr "ID de cliente"

msgid "Client Secret"
msgstr "Segredo de cliente"

msgid "Buttons"
msgstr "Botões"

msgid "Button theme"
msgstr "Tema dos botões"

#. translators: %s: button label (e.g. Continue with Google).
#, php-format
msgid "Show the “%s” button"
msgstr "Mostrar o botão “%s”"

msgid "Set in wp-config.php"
msgstr "Definido no wp-config.php"

#. translators: %s: PHP constant name.
#, php-format
msgid "The %s constant takes precedence; this field is locked."
msgstr "A constante %s tem prioridade; este campo está bloqueado."

msgid "•••••• (saved — leave blank to keep)"
msgstr "•••••• (guardado — deixe em branco para manter)"

#. translators: %s: PHP constant name.
#, php-format
msgid "Recommended: define %s in wp-config.php so the secret is never stored in the database."
msgstr "Recomendado: defina %s no wp-config.php para que o segredo nunca fique guardado na base de dados."

msgid "Light"
msgstr "Claro"

msgid "Dark"
msgstr "Escuro"

msgid "Applies to every “Continue with …” button."
msgstr "Aplica-se a todos os botões “Continuar com …”."

msgid "Settings tabs"
msgstr "Separadores das definições"

msgid "Appearance"
msgstr "Aparência"

msgid "Status"
msgstr "Estado"

msgid "Redirect URI"
msgstr "URI de redireccionamento"

msgid "Paste this value in the provider console (click to select):"
msgstr "Cole este valor na consola do fornecedor (clique para seleccionar):"

msgid "Setup guide"
msgstr "Guia de configuração"

msgid "Enabled"
msgstr "Activado"

msgid "Client ID set"
msgstr "ID de cliente definido"

msgid "Client Secret set (via wp-config)"
msgstr "Segredo de cliente definido (via wp-config)"

msgid "Client Secret set"
msgstr "Segredo de cliente definido"

#. translators: %s: status label, e.g. “Client ID set”.
#, php-format
msgid "%s — unexpected format"
msgstr "%s — formato inesperado"

msgid "The Client ID normally ends in .apps.googleusercontent.com — check you copied the right field."
msgstr "Normalmente o ID de cliente termina em .apps.googleusercontent.com — verifique se copiou o campo certo."

msgid "The Client Secret normally starts with GOCSPX- — check you copied the right field."
msgstr "Normalmente o segredo de cliente começa por GOCSPX- — verifique se copiou o campo certo."

msgid "The Client ID should be the “Application (client) ID”, a GUID — not the secret."
msgstr "O ID de cliente deve ser o “ID da aplicação (cliente)”, um GUID — e não o segredo."

msgid "The Client Secret should be the secret’s “Value” column — this looks like the “Secret ID”."
msgstr "O segredo de cliente deve ser a coluna “Valor” do segredo — isto parece ser o “ID do segredo”."

msgid "In the Google Cloud Console, under the “Google Auth Platform” menu, follow these steps in order:"
msgstr "Na Google Cloud Console, no menu “Google Auth Platform”, siga estes passos por esta ordem:"

msgid "Create / choose a project"
msgstr "Criar / escolher um projecto"

msgid "Branding — set the app name and logo (what the user sees on the Google screen)"
msgstr "Branding — definir o nome e o logótipo da aplicação (o que o utilizador vê no ecrã do Google)"

msgid "Audience → Test users → add your own email (required for testing before publishing)"
msgstr "Público-alvo → Utilizadores de teste → adicionar o seu email (necessário para testar antes de publicar)"

msgid "Clients → Create client → type “Web application” → paste the Redirect URI (above)"
msgstr "Clientes → Criar cliente → tipo “Aplicação web” → colar o URI de redireccionamento (acima)"

msgid "When the client is created (step 4), Google shows the Client ID and the Client Secret — paste them into the form on the left."
msgstr "Ao criar o cliente (passo 4), o Google mostra o ID de cliente e o segredo de cliente — cole-os no formulário ao lado."

msgid "In the Azure portal (Microsoft Entra ID), follow these steps in order:"
msgstr "No portal Azure (Microsoft Entra ID), siga estes passos por esta ordem:"

msgid "Register an application (opens the registration form directly)"
msgstr "Registar uma aplicação (abre directamente o formulário de registo)"

msgid "under “Name”, enter your store name: it is what customers see on the Microsoft consent screen."
msgstr "em “Nome”, escreva o nome da sua loja: é o que os clientes veem no ecrã de consentimento da Microsoft."

msgid "Under “Supported account types” choose “Personal Microsoft accounts only” (the last option in the list) — that is what covers Hotmail, Outlook.com and Live."
msgstr "Em “Tipos de conta suportados” escolha “Apenas contas Microsoft pessoais” (a última opção da lista) — é o que abrange Hotmail, Outlook.com e Live."

msgid "Under “Redirect URI” select the “Web” platform and paste the Redirect URI (above). Click “Register”."
msgstr "Em “URI de redireccionamento” seleccione a plataforma “Web” e cole o URI de redireccionamento (acima). Clique em “Registar”."

msgid "You land on the app’s “Overview”: copy the “Application (client) ID” and paste it into the Client ID field on the left."
msgstr "Chega à “Descrição geral” da aplicação: copie o “ID da aplicação (cliente)” e cole-o no campo ID de cliente ao lado."

msgid "In the app’s sidebar open “Certificates & secrets” → “New client secret” → choose the expiry (recommended: 730 days / 24 months, otherwise sign-in stops working when it expires) → “Add”."
msgstr "Na barra lateral da aplicação abra “Certificados e segredos” → “Novo segredo do cliente” → escolha a validade (recomendado: 730 dias / 24 meses, caso contrário o início de sessão deixa de funcionar quando expirar) → “Adicionar”."

msgid "Copy the secret’s “Value” column (careful: NOT the “Secret ID”) — it is shown only once. That is the Client Secret; ideally define it in wp-config.php (constant shown below the field)."
msgstr "Copie a coluna “Valor” do segredo (atenção: NÃO é o “ID do segredo”) — só é mostrada uma vez. É o segredo de cliente; o ideal é defini-lo no wp-config.php (constante indicada abaixo do campo)."

msgid "To come back later to an app you already created:"
msgstr "Para voltar mais tarde a uma aplicação já criada:"

msgid "app registrations list"
msgstr "lista de registos de aplicações"

msgid "(if the list looks empty, switch to the “All applications” tab)."
msgstr "(se a lista parecer vazia, mude para o separador “Todas as aplicações”)."

msgid "or"
msgstr "ou"

#. translators: %s: provider name (Google/Microsoft).
#, php-format
msgid "An account with this email already exists. Log in with your password to link %s (or use “Lost your password?”)."
msgstr "Já existe uma conta com este email. Inicie sessão com a sua palavra-passe para associar o %s (ou use “Perdeu a palavra-passe?”)."

#. translators: %s: provider name (Google/Microsoft).
#, php-format
msgid "Your %s account email is not verified, so it cannot be used to sign in here."
msgstr "O email da sua conta %s não está verificado, por isso não pode ser usado para iniciar sessão aqui."

msgid "Your sign-in session expired. Go back to the account page and try again."
msgstr "O seu pedido de início de sessão expirou. Volte à página da conta e tente novamente."

#. translators: %s: provider name (Google/Microsoft).
#, php-format
msgid "Could not validate the response from %s. If this keeps happening, please contact us."
msgstr "Não foi possível validar a resposta do %s. Se continuar a acontecer, contacte-nos."

#. translators: %s: provider name (Google/Microsoft).
#, php-format
msgid "Could not sign in with %s."
msgstr "Não foi possível iniciar sessão com o %s."

#. translators: %s: provider name (Google/Microsoft).
#, php-format
msgid "Signing in with %s failed. Please try again."
msgstr "O início de sessão com o %s falhou. Tente novamente."

msgid "Continue with Google"
msgstr "Continuar com o Google"

msgid "Continue with Microsoft"
msgstr "Continuar com a Microsoft"
