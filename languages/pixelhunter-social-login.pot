msgid "To come back later to an app you already created:"
msgstr ""

#: includes/class-admin.php:396
msgid "app registrations list"
msgstr ""

#: includes/class-admin.php:397
msgid "(if the list looks empty, switch to the “All applications” tab)."
msgstr ""

