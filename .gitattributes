# O zipball que o GitHub gera para cada release respeita export-ignore:
# tira pastas de desenvolvimento para os utilizadores instalarem só o essencial.
/tests      export-ignore
/docs       export-ignore
/.github    export-ignore
assets/screenshot-*.png export-ignore
/.gitignore export-ignore
/.gitattributes export-ignore
/.distignore export-ignore
/phpcs.xml.dist export-ignore
/.wordpress-org export-ignore
# As traduções vêm do translate.wordpress.org; os ficheiros ficam no repo
# (fonte + uso local) mas não seguem no pacote distribuído.
/languages export-ignore
